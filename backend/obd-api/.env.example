PORT=5000
NODE_ENV=development
OBD_AUTH_MODE=development
OBD_STORAGE=local
OBD_CORS_ORIGINS=*
# Optional local data location; defaults to ./data/mechaniq.json
# MECHANIQ_DATA_DIR=./data

# For production, use Firebase Auth ID tokens and Realtime Database:
# NODE_ENV=production
# OBD_AUTH_MODE=firebase
# OBD_STORAGE=firebase
# OBD_CORS_ORIGINS=https://your-frontend.example
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=mechaniq-3a0f2
# FIREBASE_DATABASE_URL=https://mechaniq-3a0f2-default-rtdb.firebaseio.com
