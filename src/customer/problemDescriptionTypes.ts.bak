export type ProblemDescriptionRequest = {
  vehicleId: string
  description: string
  submittedAt: string
}

export type ProblemDescriptionAnalysisStatus =
  | 'submitted'
  | 'unavailable'

export type ProblemDescriptionAnalysisResult = {
  status: ProblemDescriptionAnalysisStatus
  resultId: string | null
  message: string
}